{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "etzhayyim-open-power",
  "main": "svelte/.svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-04-20",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "account_id": "4da88288dc30d9ee257f319d3c33ecf0",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "open-power.etzhayyim.com/*",
      "zone_name": "etzhayyim.com"
    }
  ],
  "vars": {
    "APP_HANDLE": "open-power.etzhayyim.com",
    "PRIMARY_DID": "did:web:open-power.etzhayyim.com",
    "APP_FRAMEWORK": "sveltekit-edge-bff",
    "AGENTGATEWAY_MCP_ROUTER_URL": "https://mcp.etzhayyim.com/xrpc/com.etzhayyim.mcp.message"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "./svelte/.svelte-kit/cloudflare/client",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  }
}
