{
  "$schema": "https://etzhayyim.com/schemas/camunda-form/v1",
  "formKey": "openPower.defineFeeder.v1",
  "name": "Define Feeder",
  "version": 1,
  "lexiconRef": "com.etzhayyim.apps.openPower.defineFeeder",
  "components": [
    {
      "key": "substationDid",
      "label": "Substation DID (origin)",
      "type": "textfield",
      "validate": { "required": true, "pattern": "^did:[a-z]+:.+" }
    },
    {
      "key": "feederCode",
      "label": "Feeder code",
      "type": "textfield",
      "validate": { "required": true, "pattern": "^[A-Z0-9-]{2,16}$" }
    },
    {
      "key": "voltageClassKv",
      "label": "Voltage class (kV)",
      "type": "number",
      "validate": { "required": true, "min": 0.1, "max": 800 },
      "defaultValue": 6.6
    },
    {
      "key": "ratedAmps",
      "label": "Rated current (A)",
      "type": "number",
      "validate": { "required": true, "min": 1 }
    },
    {
      "key": "servicePoints",
      "label": "Service points (JSON: [{code,name,voltageClassKv}])",
      "type": "textarea",
      "validate": { "required": true }
    }
  ],
  "variableMappings": {
    "substationDid": "substationDid",
    "feederCode": "feederCode",
    "voltageClassKv": "voltageClassKv",
    "ratedAmps": "ratedAmps",
    "servicePoints": "servicePoints"
  }
}
